{
  "id": "leaf-commons",
  "name": "Nova Commons",
  "version": "0.1.0",
  "kernelApi": "^0.1.0",
  "description": "A private, owner-gated Envoy for the Nova Commons relay.",
  "icon": "ph-leaf",
  "color": "emerald",
  "requires": ["entities", "records", "discussions", "nova"],
  "backend": { "assembly": "Leaf.Plugins.LeafCommons" },
  "frontend": {
    "package": "leaf-commons-web",
    "settings": {},
    "extensions": [{
      "id": "commons",
      "target": "nova",
      "slot": "app-section",
      "order": 3,
      "description": "Envoy connection, shareable set, and handoff previews",
      "section": {
        "name": "Commons",
        "icon": "ph-bold ph-leaf",
        "path": "commons",
        "description": "Manage the Nova Commons Envoy",
        "legacyRoute": "/apps/leaf-commons"
      }
    }]
  },
  "permissions": [
    { "kind": "net", "target": "127.0.0.1", "reason": "Owner-configured local relay and RedLeaf/RedCompute loopback APIs" },
    { "kind": "os", "target": "issue-system-execution-token", "reason": "Deliver a typed digest into the configured system-readable Nova discussion" }
  ]
}
